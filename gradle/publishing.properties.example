# Copy these properties to ~/.gradle/gradle.properties (or set as environment variables).
# Generate a user token at https://central.sonatype.com/account

mavenCentralUsername=YOUR_CENTRAL_PORTAL_USERNAME
mavenCentralPassword=YOUR_CENTRAL_PORTAL_PASSWORD

signing.keyId=YOUR_GPG_KEY_ID
signing.password=YOUR_GPG_KEY_PASSWORD
signing.secretKeyRingFile=/path/to/.gnupg/secring.gpg

# CI alternative (in-memory key):
# ORG_GRADLE_PROJECT_mavenCentralUsername=...
# ORG_GRADLE_PROJECT_mavenCentralPassword=...
# ORG_GRADLE_PROJECT_signingInMemoryKey="$(gpg --export-secret-keys --armor YOUR_GPG_KEY_ID)"
# ORG_GRADLE_PROJECT_signingInMemoryKeyId=YOUR_GPG_KEY_ID
# ORG_GRADLE_PROJECT_signingInMemoryKeyPassword=YOUR_GPG_KEY_PASSWORD
