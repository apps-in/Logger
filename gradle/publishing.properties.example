# Copy these properties to %USERPROFILE%\.gradle\gradle.properties (Windows)
# or ~/.gradle/gradle.properties (Linux/macOS).
# Generate a user token at https://central.sonatype.com/account

mavenCentralUsername=YOUR_CENTRAL_PORTAL_USERNAME
mavenCentralPassword=YOUR_CENTRAL_PORTAL_PASSWORD

# Option A (recommended on Windows with modern GnuPG): sign via gpg executable
signing.useGpgCmd=true
signing.keyId=21912616
signing.password=YOUR_GPG_KEY_PASSWORD

# Do NOT use ~ in paths on Windows. Do NOT use secretKeyRingFile with modern GnuPG/keyboxd.

# Option B (CI or when gpg cmd signing fails): in-memory armored key
# ORG_GRADLE_PROJECT_signingInMemoryKey=<output of: gpg --export-secret-keys --armor 21912616>
# ORG_GRADLE_PROJECT_signingInMemoryKeyId=21912616
# ORG_GRADLE_PROJECT_signingInMemoryKeyPassword=YOUR_GPG_KEY_PASSWORD

# Option C (Windows helper script):
# .\publish.ps1 -GpgPassword 'YOUR_GPG_KEY_PASSWORD'
